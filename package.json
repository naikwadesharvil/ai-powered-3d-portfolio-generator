{
  "name": "ai-powered-3d-portfolio-generator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:server": "tsx server/index.ts",
    "server": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "generate:frames": "node scripts/generate_frames.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:server": "node test_server_ai.mjs",
    "test:resume": "node test_resume_export.mjs && node test_resume_edge_cases_and_inspect.mjs",
    "test:phase3": "node test_phase3_split_customizer.mjs",
    "test:all": "node test_verification.mjs && node test_server_ai.mjs && node test_resume_export.mjs && node test_resume_edge_cases_and_inspect.mjs && node test_phase3_split_customizer.mjs",
    "verify": "npm run test:all && node test_phase5_followups.mjs && node test_phase6_publish.mjs && npx tsx test_sanitization_proof.ts && node test_studio_regression.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/file-saver": "^2.0.7",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "docx": "^9.10.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "file-saver": "^2.0.5",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.55.0",
    "openai": "^7.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "puppeteer-core": "^25.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
