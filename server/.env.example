# ==============================================================================
# AI-POWERED 3D PORTFOLIO GENERATOR — SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `server/.env` and supply your actual credentials.
# IMPORTANT: Never commit `server/.env` or expose API keys to the frontend.

# Server Port
PORT=5000

# Allowed Frontend Client Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model to use (e.g., gpt-4o, gpt-4o-mini)
OPENAI_MODEL=gpt-4o

# Rate Limiting Configuration (Defaults: 100 requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
