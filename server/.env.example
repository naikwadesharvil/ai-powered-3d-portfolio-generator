# ==============================================================================
# AI-POWERED 3D PORTFOLIO GENERATOR — SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `server/.env` (or `.env` in repository root) and supply your configuration.
# IMPORTANT: Never commit `.env` or `server/.env` with private keys.

# HTTP Server Port (Default: 5000; or dynamically provided by hosting platform e.g., Render/Railway/Fly)
PORT=5000

# Node Environment ('production' | 'development')
NODE_ENV=production

# Allowed Frontend Client Origins for CORS (comma-separated list for external clients)
# In unified single-process production, Express serves both static frontend and API on the same origin.
CLIENT_ORIGIN=http://localhost:5173
# CLIENT_ORIGINS=http://localhost:5173,https://yourdomain.com

# Optional: Path to built frontend static bundle (defaults to ./dist)
DIST_PATH=dist

# OpenAI API Configuration (Optional)
# If provided, dynamic synthesis uses OpenAI structured outputs; if absent or quota exhausted,
# the system automatically and seamlessly falls back to the deterministic offline fact-governed engine.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Rate Limiting Configuration
# RATE_LIMIT_WINDOW_MS: Window duration in milliseconds (Default: 900000 = 15 minutes)
# RATE_LIMIT_MAX: Maximum requests allowed per window per IP (Default: 200)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Daily Cost & Rate Limiting Caps for OpenAI Endpoints (Phase 7c)
# Enforces strict daily request ceiling to prevent unexpected billing.
# When quota is reached, requests seamlessly fall back to offline generation with a friendly message.
OPENAI_DAILY_CAP_GLOBAL=100
OPENAI_DAILY_CAP_IP=20

