# Environment Variables Configuration
# Copy this file to .env.local to configure custom AI models or analytics.
# The platform functions 100% offline with zero required external keys by default.

# Optional: Google Gemini API Key for extended cloud LLM reasoning
VITE_GEMINI_API_KEY=""

# Optional: Supabase configuration for multi-user cloud authentication and persistence
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Application Environment
VITE_APP_ENV="development"
