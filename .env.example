# ==============================================================================
# AI-POWERED 3D PORTFOLIO GENERATOR — ROOT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `.env` to configure your environment.
# The platform functions 100% offline with zero required external keys by default.

# Server Port (Default: 5000; or dynamically assigned by host)
PORT=5000

# Environment Mode ('production' | 'development')
NODE_ENV=production

# Allowed Frontend Client Origins for CORS (comma-separated if serving client on separate origin)
CLIENT_ORIGIN=http://localhost:5173
# CLIENT_ORIGINS=http://localhost:5173,https://yourdomain.com

# Optional: Static Assets Path (Default: dist)
DIST_PATH=dist

# Optional: OpenAI API Key for real-time generative bio & project synthesis
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Daily Cost & Rate Limiting Caps for OpenAI Endpoints (Phase 7c)
# Global daily cap across all users (requests/day)
OPENAI_DAILY_CAP_GLOBAL=100
# Per-IP daily cap (requests/day)
OPENAI_DAILY_CAP_IP=20

